# Copy to .env and fill in DECIDE_API_KEY (e.g. `openssl rand -hex 32`).
DECIDE_API_KEY=
# Optional comma-separated additional API keys (each key gets its own fair round-robin queue).
DECIDE_EXTRA_API_KEYS=

# Bind address and host port. Keep 127.0.0.1 unless reached over a private network (WireGuard/Tailscale)
# or behind a TLS reverse proxy.
DECIDE_BIND_ADDRESS=127.0.0.1
DECIDE_PORT=8000

# Target CUDA SM architecture at build time (61=Tesla P4/P40, 75=T4/20xx, 86=30xx/A10, 89=40xx/L4).
CUDA_ARCH=61
BUILD_JOBS=3

# Inference tuning (defaults validated for Tesla P4 8 GB)
DECIDE_MAX_REQUEST_TOKENS=16384
DECIDE_CTX_SIZE=16384
DECIDE_MAX_BATCH_SIZE=1
DECIDE_THREADS=4

# Queue protection (0 disables each limit)
DECIDE_MAX_QUEUE_SIZE=32
DECIDE_MAX_QUEUE_PER_KEY=16
DECIDE_QUEUE_TIMEOUT_S=60

# Logging (highlight >1000ms in yellow; color: always|auto|never)
DECIDE_LOG_SLOW_MS=1000
DECIDE_LOG_COLOR=always
